# Copy this file to server/.env and fill in real values. Never commit .env.

# Anthropic API key used for document analysis and grounded Q&A.
# If left blank, the server runs in MOCK MODE: it uses a deterministic,
# rule-based analyzer instead of calling a live LLM. This keeps the app
# fully runnable/demoable and testable without any credentials, but
# answers will be much less capable than with a real key.
ANTHROPIC_API_KEY=

# Model to use for analysis and chat. Defaults to a current Claude model.
ANTHROPIC_MODEL=claude-sonnet-4-5

# Port the API server listens on.
PORT=4000

# Comma-separated list of origins allowed to call the API (CORS).
CLIENT_ORIGIN=http://localhost:5173

# Max upload size in bytes for a single document (default 8 MB).
MAX_UPLOAD_BYTES=8388608

# Minutes of inactivity before an in-memory document session is purged.
SESSION_TTL_MINUTES=60
